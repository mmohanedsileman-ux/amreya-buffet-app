# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Sheets & Apps Script Decoupled Integration (Vercel / Server Environment Variables)
# Server-side authoritative Apps Script Web App (/exec) URL used by /api/submit_order and /api/sync_debt
APPS_SCRIPT_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbyL2B7HxSxaox7qpl4tEX5FIFKK3Xqr6uAFCMER5ZvPv2trUQYFtxrgf_V8Du0pVLBw4A/exec"
# Server-side authoritative Google Spreadsheet ID
GOOGLE_SHEET_ID="1oudlw-7BB4fDDH09Hp-FJWHDzp8ms16NKf7Z_1KS4y8"

# Optional client-side public overrides (Vite exposes VITE_* variables to the browser bundle)
VITE_GOOGLE_SHEET_ID="1oudlw-7BB4fDDH09Hp-FJWHDzp8ms16NKf7Z_1KS4y8"
VITE_APPS_SCRIPT_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbyL2B7HxSxaox7qpl4tEX5FIFKK3Xqr6uAFCMER5ZvPv2trUQYFtxrgf_V8Du0pVLBw4A/exec"

